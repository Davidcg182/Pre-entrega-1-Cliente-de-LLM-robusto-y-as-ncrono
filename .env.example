# Copia este archivo a `.env` y rellena lo que necesites.
# `.env` está en .gitignore: nunca subas claves al repositorio.

# Proveedor activo: openai | anthropic | fake
# `fake` no necesita clave ni red: sirve para probar el repo sin coste.
LLM_PROVIDER=fake

# Vacío = modelo por defecto del proveedor
# (openai: gpt-4o-mini · anthropic: claude-sonnet-5 · fake: fake-1)
LLM_MODEL=

# --- Credenciales ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Endpoints alternativos (opcional) ---
# El SDK de OpenAI habla un protocolo, no sólo con OpenAI. Con una clave de
# Google AI Studio (gratuita) puedes ejecutar el MISMO OpenAIClient así:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gemini-2.5-flash
#   OPENAI_API_KEY=<tu clave AIza...>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# --- Parámetros del modelo (validados por Pydantic al arrancar) ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# --- Resiliencia ---
LLM_TIMEOUT_S=30
LLM_STREAM_IDLE_TIMEOUT_S=15
LLM_MAX_RETRIES=2
